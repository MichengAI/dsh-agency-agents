{
  "name": "@deepseek-ai/dsh-agency-agents",
  "description": "Agency Experts — a summonable domain-expert roster for DSH (expert mode)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/agency-agents",
    "assets/branding",
    "assets/screenshots",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "pnpm typecheck && tsdown src/index.ts --format esm --out-dir lib --platform node --dts --no-fixed-extension --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
